# Copy to .env (never commit it) and load with your process manager, e.g. systemd EnvironmentFile=.
VCOOS_DEBUG=0
VCOOS_SECRET_KEY=change-me-to-a-long-random-string
# Fernet key for encrypted provider credentials:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
VCOOS_ENCRYPTION_KEY=
VCOOS_ALLOWED_HOSTS=vcoos.example.com
VCOOS_CSRF_TRUSTED_ORIGINS=https://vcoos.example.com

# Database (omit for SQLite development)
VCOOS_DB_ENGINE=postgres
VCOOS_DB_NAME=vcoos
VCOOS_DB_USER=vcoos
VCOOS_DB_PASSWORD=
VCOOS_DB_HOST=localhost
VCOOS_DB_PORT=5432

# Redis: enables cross-process live updates, shared rate limiting and Celery
VCOOS_REDIS_URL=redis://localhost:6379/0
VCOOS_EXECUTION_BACKEND=worker   # "worker" (manage.py run_engine) or "celery"

# Storage
VCOOS_WORKSPACE_ROOT=/var/lib/vcoos/workspaces
VCOOS_BACKUP_ROOT=/var/lib/vcoos/backups
VCOOS_REPORT_ROOT=/var/lib/vcoos/reports

# Sandbox: strongly recommended OS-level isolation for agent code (bubblewrap example)
# VCOOS_SANDBOX_WRAPPER=bwrap --unshare-all --die-with-parent --ro-bind /usr /usr --ro-bind /lib /lib --ro-bind /lib64 /lib64 --bind /var/lib/vcoos/workspaces /var/lib/vcoos/workspaces --proc /proc --dev /dev

# Email for password reset
VCOOS_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
VCOOS_EMAIL_HOST=smtp.example.com
VCOOS_EMAIL_PORT=587
VCOOS_EMAIL_USER=
VCOOS_EMAIL_PASSWORD=
VCOOS_EMAIL_TLS=1
VCOOS_FROM_EMAIL=vcoos@example.com

# Provider API keys are referenced from provider settings as env:NAME, e.g.
# OPENAI_API_KEY=  ANTHROPIC_API_KEY=  GEMINI_API_KEY=  XAI_API_KEY=  NVIDIA_API_KEY=
