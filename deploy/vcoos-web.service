[Unit]
Description=VCoOS web (Uvicorn ASGI: HTTP + WebSockets)
After=network.target postgresql.service redis.service

[Service]
User=vcoos
Group=vcoos
WorkingDirectory=/opt/vcoos
EnvironmentFile=/etc/vcoos/vcoos.env
# --workers > 1 requires VCOOS_REDIS_URL (Redis channel layer) so WebSocket events reach every process.
ExecStart=/opt/vcoos/.venv/bin/uvicorn config.asgi:application --host 127.0.0.1 --port 8000 --workers 2 \
          --proxy-headers --forwarded-allow-ips 127.0.0.1 --no-server-header --ws-max-size 1048576 --limit-concurrency 500
Restart=always
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/vcoos

[Install]
WantedBy=multi-user.target
