[Unit]
Description=VCoOS web (Daphne ASGI: HTTP + WebSockets)
After=network.target postgresql.service redis.service

[Service]
User=vcoos
Group=vcoos
WorkingDirectory=/opt/vcoos
EnvironmentFile=/etc/vcoos/vcoos.env
ExecStart=/opt/vcoos/.venv/bin/daphne -b 127.0.0.1 -p 8000 --proxy-headers config.asgi:application
Restart=always
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/vcoos

[Install]
WantedBy=multi-user.target
